rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server-only. Profiles and the `role` field are written exclusively by the
    // `ensureUserProfile` server action, which verifies the caller's ID token
    // and decides the role itself. Clients must never write here: while this was
    // `if request.auth != null`, any signed-in learner could PATCH their own
    // `role` to "admin" and the panel's canAccessAdminPanel() check would then
    // let them in. Reads are closed too — the role is fetched through the same
    // verified path, so no client needs direct access.
    match /users/{userId} {
      allow read, write: if false;
    }
    match /courses/{courseId} {
      allow read, write: if request.auth != null;
    }
    match /scormData/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scenarios/{scenarioId} {
      allow read, write: if request.auth != null;
    }

    // Ratings and reviews are written only through the `submitRating` server
    // action, which verifies the caller's ID token and derives the author from
    // it. Clients are denied outright so a forged request can never reach the
    // collection directly. Every other collection here is client-writable; this
    // one deliberately is not. Writes still work because the Admin SDK bypasses
    // rules entirely.
    match /ratings/{ratingId} {
      allow read, write: if false;
    }
  }
}
